{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core events, folder picker, opener, and Prism's own commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:default",
    "allow-workspace-initial",
    "allow-workspace-open",
    "allow-workspace-current",
    "allow-fs-list",
    "allow-fs-stat",
    "allow-fs-read",
    "allow-open-external",
    "allow-log-line"
  ]
}
