{
  "name": "prism",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/renderers/*"
  ],
  "scripts": {
    "check": "biome check . && bun run typecheck && bun run boundaries",
    "fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "boundaries": "bun scripts/check-boundaries.ts",
    "test": "bun test --pass-with-no-tests",
    "dev:ui": "bun run --cwd packages/ui dev",
    "dev:desktop": "bun scripts/dev-desktop.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "bun-types": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
